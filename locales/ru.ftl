##############################################################################################

statistics-title =
    Статистика за последние { $days } дней

statistics-filled-days =
    {"**"}Заполнено дней:{"**"} { $filled_days } из { $days }

statistics-average-duration =
    {"**"}Средняя продолжительность сна:{"**"} { $average_duration }

statistics-average-rating =
    {"**"}Средняя оценка:{"**"} { $average_rating }

