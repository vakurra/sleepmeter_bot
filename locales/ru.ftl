##############################################################################################
### Обратная связь и поддержка
##############################################################################################

feedback-start =
    { $wink } Напишите замечание, предложение или расскажите о проблеме.

    <b>Следующее ваше сообщение будет отправлено разработчику.</b>

feedback-support =
    { $heart } Спасибо за желание поддержать проект!

    Выберите сумму:

feedback-not-text =
    Я принимаю только текстовые сообщения.
    Попробуйте отправить текст.

feedback-sent =
    { $success } Спасибо! Сообщение отправлено разработчику.

feedback-cancelled =
    { $cancel_desc } Отправка отменена.

feedback-new =
    💬 <b>Новая обратная связь</b>

    <b>От:</b> { $full_name }
    <b>Username:</b> @{ $username }
    <b>ID:</b> <code>{ $user_id }</code>

    <b>Сообщение:</b>
    { $message }

support-payment-title =
    Поддержать разработчика

support-payment-description =
    Это действие не открывает никаких дополнительных функций.

support-payment-label =
    Поддержка проекта

support-payment-success =
    { $heart } Спасибо за поддержку!

    Она помогает развивать проект и делать его лучше.

refund-missing-id =
    Не указан ID транзакции

refund-success =
    { $success } Возврат успешно выполнен!

refund-already-refunded =
    { $error } Возврат уже выполнен

refund-invalid-id =
    { $not_found } Неверный ID транзакции

paysupport =
    { $broken_heart } Если вы хотите вернуть звезды за поддержку проекта, это можно сделать в течение 21 дня.

    Используйте команду:

    <code>/refund ID_ТРАНЗАКЦИИ</code>


