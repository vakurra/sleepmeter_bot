##############################################################################################
### Регистрация
##############################################################################################

start-welcome =
    { $hi } Добро пожаловать, { $name }! Я Somnus!
    
    Я помогу отслеживать продолжительность вашего сна.
    Для начала потребуется всего две настройки.

    <b>Выберите ваш часовой пояс:</b>

start-reminder =
    <b>Когда вам удобно получать напоминание внести запись о сне?</b>

    <i>(Их можно будет отключить в настройках)</i>

start-complete-registration =
    { $success } <b>Регистрация завершена!</b>

    С завтрашнего дня я буду ежедневно присылать напоминание в выбранное время.

start-return =
    { $hi } С возвращением, { $name }!

start-whats-next = { $question } Чем займемся дальше?


##############################################################################################
### Запись о сне
##############################################################################################

sleep-record-start = { $moon_desc } Во сколько вы легли спать?

sleep-record-start-notification =
    { $moon_desc } Доброе утро!

    Давайте сделаем запись за { $record_date }.
    Во сколько вы легли спать?

sleep-record-start-manual =
    { $moon_desc } Введите время отхода ко сну в формате ЧЧ:ММ

    <i>(Например, 23:45)</i>

sleep-record-for = { $calendar_desc } <b>Запись за: { $record_date }</b>

sleep-record-wakeup = { $sunrise } Во сколько проснулись?

sleep-record-wakeup-manual =
    { $sunrise } Введите время пропуждения в формате ЧЧ:ММ

    <i>(Например, 08:45)</i>

sleep-record-rating = { $star } Оцените качество сна:

sleep-record-exist = { $ex_mark } Запись за сегодняшний день уже существует.

sleep-record-date =
    { $calendar_desc } Введите дату записи:

    <i>(Например, 05.07.2026 или 05.07.26)</i>

sleep-record-edit-for =
    { $calendar_desc } Найдена запись за { $record_date }
    
    Изменяем её.

sleep-record-create-for =
    { $calendar_desc } Записи за { $record_date } нет.
    
    Создадим её.

sleep-record-edit-success =
    { $success } Запись успешно { $verb }!

sleep-record-edit-table =
    { $moon_desc } {"**"}Отбой{"**"} | { $sleep_start }
    { $sunrise } {"**"}Подъем{"**"} | { $sleep_end }
    { $sleep_desc } {"**"}Сон{"**"} | { $sleep_duration_text }
    { $star } {"**"}Оценка{"**"} | { $sleep_rating }/5

sleep-record-date-invalid =
    { $error } Некорректная дата.

    Введите дату в формате ДД.ММ.ГГ"

sleep-record-time-invalid =
    { $error } Некорректный формат.

    Введите время в формате ЧЧ:ММ

sleep-record-cancel = { $cancel_desc } Добавление записи отменено.  

